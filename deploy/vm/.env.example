# RESafety Tool - VM deployment configuration template.
#
# Copy this file to .env in the same directory and fill in real values:
#     cp .env.example .env && chmod 600 .env
# The real .env is git-ignored and docker-ignored; never commit it.
#
# Docker Compose reads .env twice:
#   1) for ${VAR} interpolation in docker-compose.yml (the `db` service), and
#   2) injected into the `app` container via `env_file:`.
#
# NOTE: DB_HOST/DB_PORT and PORT are intentionally NOT set here - docker-compose.yml
# wires the app to the `db` service, and Quarkus defaults to port 8080.

# --- Database (used by BOTH the db container and the app's JDBC fallback) ---
# DB_PASSWORD MUST be clean alphanumeric/hex: no spaces, quotes, '#', or newlines.
# PostgreSQL SCRAM auth (SASLprep, RFC 4013) rejects control characters and fails
# login with "Prohibited character" if a stray newline/space sneaks in.
DB_NAME=resafetytool
DB_USER=resafetytool
DB_PASSWORD=change-me-to-a-clean-alphanumeric-secret

# --- Gemini AI (in-process AI generation) ---
# Needs outbound HTTPS to generativelanguage.googleapis.com. If that egress is
# blocked on the VM, the app still runs but every "Generate with AI" button fails.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# --- Login users (JWT issuance) ---
# Format: "username:password,username2:password2". No default users are shipped.
AUTH_USERS=admin:change-me,manager:change-me-too

# --- JWT issuer / lifespan ---
AUTH_JWT_ISSUER=https://resafetytool.cin.ufpe.br
AUTH_JWT_LIFESPAN_SECONDS=3600

# --- CORS ---
# SPA and API are same-origin, so restrict to the public hostname.
CORS_ORIGINS=https://resafetytool.cin.ufpe.br

# --- Optional: behind the CIn reverse proxy ---
# Uncomment for correct client-IP logging / forwarded headers (purely additive).
# QUARKUS_HTTP_PROXY_PROXY_ADDRESS_FORWARDING=true
